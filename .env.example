# Copy to .env (backend) / apps/web/.env.local (frontend). Never commit real secrets.

# --- Backend (services/api) ---
# Local mongod, or a personal Atlas free cluster URI (mongodb+srv://USER:PASSWORD@cluster.mongodb.net)
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=Project0
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me
CORS_ORIGINS=http://localhost:3000
MAX_UPLOAD_MB=25
# Accounts allowed to reset demo data (comma-separated emails)
ADMIN_EMAILS=
# Free Atlas tier is 512 MB: release old data above this many MB
STORAGE_BUDGET_MB=380
PUBLIC_BASE_URL=http://localhost:8000

# --- Frontend (apps/web) ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
